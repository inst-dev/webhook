# =============================================================================
# Webhook.inst.lk - Environment Configuration
# =============================================================================

# Application
APP_ENV=production
APP_NAME=webhook.inst.lk
APP_DEBUG=false

# Domain Configuration
DOMAIN=webhook.inst.lk
API_DOMAIN=api.webhook.inst.lk
WS_DOMAIN=ws.webhook.inst.lk
CONSOLE_DOMAIN=console.webhook.inst.lk
DNS_DOMAIN=dns.webhook.inst.lk
SMTP_DOMAIN=smtp.webhook.inst.lk

# Port Configuration (2000-2999 range)
FRONTEND_PORT=2100
API_PORT=2200
WS_PORT=2300
CONSOLE_PORT=2400
DNS_PORT=2500
SMTP_PORT=2600
WORKER_PORT=2700

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=webhook
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=webhook
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=50
POSTGRES_MIN_CONNS=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password_here
REDIS_DB=0
REDIS_MAX_RETRIES=3

# JWT Configuration
JWT_SECRET=changeme_jwt_secret_minimum_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=webhook.inst.lk

# Security
CSRF_SECRET=changeme_csrf_secret_here
COOKIE_DOMAIN=.webhook.inst.lk
COOKIE_SECURE=true
CORS_ORIGINS=https://webhook.inst.lk,https://console.webhook.inst.lk

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Payload Limits
PAYLOAD_MAX_FREE=524288
PAYLOAD_MAX_PREMIUM=5242880

# Retention (hours)
RETENTION_FREE=72
RETENTION_PRO=720
RETENTION_TEAM=2160
RETENTION_ENTERPRISE=8760

# SMTP Configuration
SMTP_LISTEN_PORT=25
SMTP_DOMAIN=emailhook.webhook.inst.lk
SMTP_MAX_MESSAGE_SIZE=10485760

# DNS Configuration
DNS_LISTEN_PORT=53
DNS_ZONE=dns.webhook.inst.lk

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=2800
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=changeme_metrics_token

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Billing - PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Billing - PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# TLS
TLS_CERT_PATH=/etc/ssl/certs/webhook.inst.lk.pem
TLS_KEY_PATH=/etc/ssl/private/webhook.inst.lk.key
